---
import Base from '../../layouts/Base.astro';
import GigList from '../../components/GigList.astro';
import { highlights } from '../../data/site';
import { url, upcomingGigs } from '../../lib/util';

const gigs = await upcomingGigs();
---

<Base title="Höhepunkte" description="Kommende Auftritte und bisherige Highlights von moonstruck.">
  <div class="wrap">
    <header class="page-head">
      <span class="eyebrow">Höhepunkte</span>
      <h1>Termine <span class="hl">&amp; Highlights</span></h1>
      <p class="lead">Die nächsten öffentlichen Auftritte der moonstruck. Private Anlässe sind hier nicht aufgeführt.</p>
    </header>

    <GigList gigs={gigs} />

    <section class="section">
      <h2>Bisherige Band-Highlights</h2>
      <p class="lead">Wenn Ihr wissen wollt, was und wo die bisherigen Höhepunkte der moonstruck waren:</p>
      <ul class="hl-list">
        {highlights.map((h) => <li class="panel">{h}</li>)}
      </ul>
      <a class="btn btn--accent" href={url('/events/fotogalerien/')}>Zu den Fotogalerien</a>
    </section>
  </div>
</Base>

<style>
  .section {
    margin-top: 16px;
  }
  .hl-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .hl-list li {
    position: relative;
    padding: 13px 16px 13px 42px;
    font-size: 0.95rem;
  }
  .hl-list li::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: 50%;
    box-shadow: inset -4px 2px 0 0 var(--accent);
  }
</style>
