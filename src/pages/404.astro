---
import Base from '../layouts/Base.astro';
import { url } from '../lib/util';
---

<Base title="Seite nicht gefunden">
  <section class="section section--dark moon">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Diese Seite spielt heute nicht.</h1>
      <p class="lead">Die gesuchte Seite gibt es nicht (mehr). Vielleicht finden Sie hier, was Sie suchen:</p>
      <a class="btn btn--light" href={url('/')}>Zur Startseite</a>
    </div>
  </section>
</Base>
