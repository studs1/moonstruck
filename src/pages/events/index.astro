---
import Base from '../../layouts/Base.astro';
import GigList from '../../components/GigList.astro';
import { highlights } from '../../data/site';
import { url, upcomingGigs } from '../../lib/util';
import { eventSchema, breadcrumbSchema } from '../../lib/schema';

const gigs = await upcomingGigs();
const jsonLd = [
  ...gigs.map((g) => eventSchema(Astro.site, g)),
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Höhepunkte', path: '/events/' },
  ]),
];
---

<Base title="Höhepunkte" description="Kommende Auftritte und bisherige Highlights von moonstruck: Konzerte der Soul-, Blues- und Jazzband aus Visp im Wallis." jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-head">
      <span class="eyebrow">Höhepunkte</span>
      <h1>Termine <span class="hl">&amp; Highlights</span></h1>
      <p class="lead">Die nächsten öffentlichen Auftritte der moonstruck. Private Anlässe sind hier nicht aufgeführt.</p>
    </header>

    <GigList gigs={gigs} />

    <section class="section">
      <h2>Bisherige Band-Highlights</h2>
      <p class="lead">Wenn Ihr wissen wollt, was und wo die bisherigen Höhepunkte der moonstruck waren:</p>
      <ul class="hl-list">
        {highlights.map((h) => <li class="panel">{h}</li>)}
      </ul>
      <a class="btn btn--accent" href={url('/events/fotogalerien/')}>Zu den Fotogalerien</a>
    </section>
  </div>
</Base>

<style>
  .section {
    margin-top: 16px;
  }
  .hl-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .hl-list li {
    position: relative;
    padding: 13px 16px 13px 46px;
    font-size: 0.95rem;
  }
  .hl-list li::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 14px;
    width: 19px;
    height: 19px;
    background: var(--accent);
    -webkit-mask: var(--sichel) center / contain no-repeat;
    mask: var(--sichel) center / contain no-repeat;
  }
</style>
