---
import { breadcrumbSchema } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import AudioList from '../../components/AudioList.astro';
import { url } from '../../lib/util';
const jsonLd = [breadcrumbSchema(Astro.site, [{ name: 'Home', path: '/' }, { name: 'Klangprobe', path: '/die-band/klangprobe/' }])];
---

<Base title="Klangprobe" description="Hörproben der Band moonstruck: Liveaufnahmen von Hello Dolly, I Feel Good, Everybody (Blues Brothers) und mehr. New Orleans Jazz, Blues und Funk aus Visp." jsonLd={jsonLd}>
  <div class="wrap narrow">
    <header class="page-head">
      <span class="eyebrow">Klangprobe</span>
      <h1>Reinhören, <span class="hl">bevor Sie buchen</span></h1>
      <p class="lead">
        Diese Soundbeispiele sind Liveaufnahmen aus diversen Konzerten der moonstruck. Bei Bedarf können Sie auch eine
        <a href={url('/kontakt/')}>Demo-CD anfordern</a>.
      </p>
    </header>
    <div class="panel--dark box">
      <AudioList />
    </div>
  </div>
</Base>

<style>
  .narrow {
    max-width: 800px;
  }
  .box {
    padding: clamp(14px, 3vw, 24px);
  }
</style>
