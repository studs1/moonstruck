---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhotoGrid, { type PhotoItem } from '../../../components/PhotoGrid.astro';
import GigList from '../../../components/GigList.astro';
import { galleries, url, formatMonth, placeholder, upcomingGigs } from '../../../lib/util';
import { breadcrumbSchema, abs } from '../../../lib/schema';

export async function getStaticPaths() {
  const all = await galleries();
  return all.map((g, i) => ({
    params: { slug: g.id },
    props: { g, prev: all[i + 1], next: all[i - 1] },
  }));
}

const { g, prev, next } = Astro.props;
const d = g.data;
const { Content } = await render(g);
const hasBody = g.body?.trim().length;
const gigs = (await upcomingGigs()).slice(0, 1);

// Alle Bilder vorbereiten: Alt-Text, Legende, Platzhalter, grosse Version für die Lightbox
const items: (PhotoItem & { file: string })[] = await Promise.all(
  g.images.map(async ({ file, path, img }, i) => {
    const meta = d.bilder?.[file] ?? {};
    const big = await getImage({ src: img, widths: [1000, 1600, 2000].filter((w) => w <= img.width), format: 'webp' });
    const largest = Math.min(img.width, 2000);
    return {
      file,
      img,
      n: i + 1,
      alt: meta.alt ?? `${d.title}${d.ort ? `, ${d.ort}` : ''} – Foto ${i + 1}`,
      caption: meta.text,
      ph: await placeholder(path),
      full: {
        src: big.src,
        srcset: big.srcSet.attribute,
        width: largest,
        height: Math.round((largest * img.height) / img.width),
      },
    };
  }),
);

// Kapitel (optional): zugeordnete Bilder pro Kapitel, Rest am Schluss
const used = new Set(d.kapitel?.flatMap((k) => k.bilder) ?? []);
const groups = d.kapitel
  ? [
      ...d.kapitel.map((k) => ({ titel: k.titel, text: k.text, items: items.filter((it) => k.bilder.includes(it.file)) })),
      { titel: 'Weitere Bilder', text: undefined, items: items.filter((it) => !used.has(it.file)) },
    ].filter((gr) => gr.items.length)
  : [{ titel: undefined, text: undefined, items }];

const cover = items.find((it) => it.file === (d.cover ?? items[0]?.file)) ?? items[0];
const isVideo = d.clip && /\.(mp4|webm|mov)$/i.test(d.clip.src);
const pageUrl = abs(Astro.site, `/events/fotogalerien/${g.id}/`);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: `moonstruck: ${d.title}`,
    description: d.description,
    url: pageUrl,
    datePublished: d.date.toISOString().slice(0, 10),
    contentLocation: d.ort ? { '@type': 'Place', name: d.ort } : undefined,
    about: { '@id': abs(Astro.site, '/#band') },
    creator: d.fotograf ? { '@type': 'Person', name: d.fotograf } : undefined,
    numberOfItems: items.length,
    image: items.slice(0, 12).map((it) => ({
      '@type': 'ImageObject',
      contentUrl: new URL(it.full.src, Astro.site).href,
      description: it.alt,
      caption: it.caption,
      width: it.full.width,
      height: it.full.height,
    })),
  },
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Fotogalerien', path: '/events/fotogalerien/' },
    { name: d.title, path: `/events/fotogalerien/${g.id}/` },
  ]),
];
// Meta-Description: eigener Text, wenn aussagekräftig (≥ 50 Zeichen), sonst generiert (+ evtl. kurzer Text)
const generated = `Fotos der Soul-, Blues- und Jazzband moonstruck: ${d.title}${d.ort ? ` in ${d.ort}` : ''}, ${formatMonth(d.date)}. ${items.length} Bilder.`;
const metaDescription = d.description && d.description.length >= 50 ? `${d.description} – ${items.length} Fotos von moonstruck.` : generated;
const metaLine = [formatMonth(d.date), d.ort, `${items.length} Fotos`].filter(Boolean).join(' · ');
---

<Base
  title={`${d.title} (${formatMonth(d.date)})`}
  description={metaDescription}
  image={cover?.img}
  dark
  jsonLd={jsonLd}
>
  <div class="wrap">
    <a class="back" href={url('/events/fotogalerien/')}>← Alle Galerien</a>

    {
      cover && (
        <header class="hero">
          <a class="hero__img" href={cover.full.src} data-open={cover.n} style={`background-image:url(${cover.ph})`}>
            <Picture
              src={cover.img}
              alt={cover.alt}
              formats={['avif', 'webp']}
              widths={[640, 1040, 1600]}
              sizes="(max-width: 1040px) 100vw, 1040px"
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <div class="hero__text">
            <span class="eyebrow">{metaLine}</span>
            <h1>{d.title}</h1>
            {d.description && <p class="lead">{d.description}</p>}
          </div>
        </header>
      )
    }

    {
      (hasBody || d.setlist) && (
        <section class="intro">
          {hasBody && (
            <div class="intro__text">
              <Content />
            </div>
          )}
          {d.setlist && (
            <aside class="setlist panel">
              <span class="eyebrow">Aus der Setlist</span>
              <ol>
                {d.setlist.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            </aside>
          )}
        </section>
      )
    }

    {
      d.clip && (
        <section class="clip panel">
          {d.clip.titel && <span class="eyebrow">{d.clip.titel}</span>}
          {isVideo ? (
            <video controls preload="none" playsinline poster={d.clip.poster ? url(d.clip.poster) : undefined} src={url(d.clip.src)} />
          ) : (
            <audio controls preload="none" src={url(d.clip.src)} />
          )}
        </section>
      )
    }

    <div class="photos" data-gallery>
      {
        groups.map((gr) => (
          <section class="chapter">
            {gr.titel && <h2>{gr.titel}</h2>}
            {gr.text && <p class="lead">{gr.text}</p>}
            <PhotoGrid items={gr.items} />
          </section>
        ))
      }
    </div>

    {d.fotograf && <p class="credit">Fotos: {d.fotograf}</p>}

    <section class="after">
      <GigList gigs={gigs} label="Nächster Auftritt">
        <a class="btn btn--outline" href={url('/events/')}>Alle Termine</a>
      </GigList>
      <div class="cta sheet">
        <div>
          <h2>Der nächste Event mit Moonstruck?</h2>
          <p>Firmenfest, Hochzeit oder Konzert – wir freuen uns auf Ihre Anfrage.</p>
        </div>
        <div class="cta__btns">
          <a class="btn btn--dark" href={url('/kontakt/')}>Band buchen</a>
          <a class="btn btn--line" href={url('/die-band/klangprobe/')}>Klangprobe hören</a>
        </div>
      </div>
    </section>

    <nav class="pager" aria-label="Weitere Galerien">
      {
        prev ? (
          <a href={url(`/events/fotogalerien/${prev.id}/`)}>
            <small>← Ältere Galerie</small>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="right" href={url(`/events/fotogalerien/${next.id}/`)}>
            <small>Neuere Galerie →</small>
            {next.data.title}
          </a>
        )
      }
    </nav>
  </div>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  if (gallery) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a.ph',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.96,
      showHideAnimationType: 'zoom', // Bild "wächst" aus dem Raster
      closeOnVerticalDrag: true, // nach unten wischen schliesst
      wheelToZoom: true,
      padding: { top: 24, bottom: 56, left: 8, right: 8 },
      arrowPrevTitle: 'Vorheriges Bild',
      arrowNextTitle: 'Nächstes Bild',
      closeTitle: 'Schliessen',
      zoomTitle: 'Zoomen',
      errorMsg: 'Das Bild konnte nicht geladen werden.',
    });

    // Bildlegende unten einblenden
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el, pswp) => {
          pswp.on('change', () => {
            const a = pswp.currSlide?.data.element as HTMLElement | undefined;
            const text = a?.dataset.caption ?? '';
            el.textContent = text;
            el.hidden = !text;
          });
        },
      });
    });

    // Teilbarer Link pro Bild: #foto-12
    lightbox.on('change', () => {
      const n = (lightbox.pswp?.currIndex ?? 0) + 1;
      history.replaceState(null, '', `#foto-${n}`);
    });
    lightbox.on('close', () => history.replaceState(null, '', location.pathname + location.search));

    lightbox.init();

    const openAt = (n: number) => lightbox.loadAndOpen(n - 1, { gallery });
    const m = location.hash.match(/^#foto-(\d+)$/);
    if (m) openAt(Number(m[1]));

    document.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        openAt(Number(a.dataset.open));
      }),
    );
  }
</script>

<style>
  .back {
    display: inline-block;
    margin: 28px 0 16px;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .hero {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-950);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.4);
  }
  .hero__img {
    display: block;
    aspect-ratio: 16 / 9;
    max-height: 70vh;
    width: 100%;
    background-size: cover;
    background-position: center;
  }
  .hero__img :global(picture),
  .hero__img :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero__img :global(img) {
    object-fit: cover;
    object-position: 50% 35%;
  }
  .hero__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(60px, 10vw, 120px) clamp(20px, 4vw, 40px) clamp(20px, 3.5vw, 32px);
    background: linear-gradient(transparent, rgb(1 11 19 / 0.88));
    pointer-events: none;
  }
  .hero__text h1 {
    margin: 0;
  }
  .hero__text .lead {
    margin: 0.5rem 0 0;
    max-width: 60ch;
  }
  @media (max-width: 600px) {
    .hero__img {
      aspect-ratio: 4 / 3;
    }
    .hero__text {
      position: static;
      padding: 18px 18px 20px;
      background: var(--navy-950);
    }
  }

  .intro {
    display: grid;
    gap: 24px;
    margin-top: clamp(28px, 4vw, 40px);
  }
  @media (min-width: 860px) {
    .intro:has(.setlist) {
      grid-template-columns: 1.6fr 1fr;
    }
  }
  .intro__text {
    max-width: 65ch;
    font-size: 1.05rem;
    color: var(--text-soft);
  }
  .setlist {
    padding: 20px 22px;
    align-self: start;
  }
  .setlist ol {
    margin: 0.4rem 0 0;
    padding-left: 1.3rem;
  }
  .setlist li {
    padding: 0.15rem 0;
  }

  .clip {
    margin-top: 28px;
    padding: 16px;
  }
  .clip video {
    display: block;
    width: 100%;
    max-height: 70vh;
    border-radius: 8px;
    background: #000;
  }
  .clip audio {
    width: 100%;
  }

  .photos {
    margin-top: clamp(28px, 4vw, 40px);
  }
  .chapter + .chapter {
    margin-top: 40px;
  }
  .chapter h2 {
    margin-bottom: 0.3em;
  }
  .chapter .lead {
    margin-bottom: 1rem;
  }

  .credit {
    margin: 16px 0 0;
    font-size: 0.85rem;
    color: var(--text-soft);
  }

  .after {
    display: grid;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: clamp(22px, 4vw, 30px);
  }
  .cta h2 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 300;
    margin-bottom: 0.3em;
  }
  .cta p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn--line {
    border-color: var(--navy-900);
    color: var(--navy-900);
  }
  .btn--line:hover {
    background: #eef5fa;
    color: var(--navy-900);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-family: var(--font-display);
    font-weight: 500;
  }
  .pager a {
    display: grid;
    text-decoration: none;
    color: var(--white);
  }
  .pager a:hover {
    color: var(--accent);
  }
  .pager small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .pager .right {
    text-align: right;
  }

  /* PhotoSwipe: Bildlegende */
  :global(.pswp__caption) {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    max-width: min(90vw, 720px);
    padding: 8px 14px;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 0.9rem;
    text-align: center;
  }
  :global(.pswp__counter) {
    font-family: var(--font-body);
  }
</style>
