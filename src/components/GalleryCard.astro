---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url, formatMonth } from '../lib/util';

interface Props {
  slug: string;
  title: string;
  date: Date;
  count: number;
  ort?: string;
  cover?: ImageMetadata;
}
const { slug, title, date, count, cover, ort } = Astro.props;
---

<a class="gcard" href={url(`/events/fotogalerien/${slug}/`)}>
  <div class="gcard__img">
    {cover && <Image src={cover} alt="" widths={[400, 700]} sizes="(max-width: 600px) 100vw, 360px" />}
    <span class="gcard__count">{count} Fotos</span>
  </div>
  <div class="gcard__body">
    <span class="gcard__date">{formatMonth(date)}{ort && ` · ${ort}`}</span>
    <h3>{title}</h3>
  </div>
</a>

<style>
  .gcard {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .gcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgb(2 26 43 / 0.35);
    color: var(--ink);
  }
  .gcard__img {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--navy-900);
    overflow: hidden;
  }
  .gcard__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gcard:hover .gcard__img :global(img) {
    transform: scale(1.04);
  }
  .gcard__count {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    background: rgb(2 26 43 / 0.75);
    color: var(--white);
    backdrop-filter: blur(4px);
  }
  .gcard__body {
    padding: 14px 18px 18px;
  }
  .gcard__date {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue-500);
  }
  .gcard h3 {
    margin: 0.25em 0 0;
    font-size: 1.1rem;
    font-weight: 500;
  }
</style>
