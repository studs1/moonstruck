---
import '../styles/global.css';
import { Image } from 'astro:assets';
import header from '../assets/header.jpg';
import { nav } from '../data/site';
import { url } from '../lib/util';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShare from '../assets/share.jpg';
import bandPhoto from '../assets/live-stage.jpg';
import appleIcon from '../assets/apple-touch-icon.png';
import { bandSchema, abs } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Vorschaubild für WhatsApp/Social Media */
  image?: ImageMetadata;
  /** Dunkler Hintergrund (z.B. Fotogalerien) */
  dark?: boolean;
  /** zusätzliche strukturierte Daten (JSON-LD) dieser Seite */
  jsonLd?: object[];
  /** nicht indexieren (z.B. 404) */
  noindex?: boolean;
}

const {
  title,
  description = 'moonstruck – Soul, Blues & Jazz aus Visp. New Orleans Jazz, Street Jazz, Blues, Bebop und Funk für Party- und Konzertpublikum.',
  image = defaultShare,
  dark = false,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const share = await getImage({ src: image, width: 1200, format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site);
const bandShare = await getImage({ src: bandPhoto, width: 1200, format: 'jpg' });
const structured = [
  await bandSchema(Astro.site, new URL(bandShare.src, Astro.site).href),
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'moonstruck', url: abs(Astro.site, '/'), inLanguage: 'de-CH', publisher: { '@id': abs(Astro.site, '/#band') } },
  ...jsonLd,
];

const fullTitle = title ? `${title} | moonstruck – Soul, Blues & Jazz aus Visp` : 'moonstruck – Soul, Blues & Jazz Band aus Visp (Wallis)';
const current = (Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/').replace(/\/?$/, '/');
// Aktiv ist der Menüpunkt mit dem längsten passenden Pfad-Präfix (/die-band/ vs. /die-band/klangprobe/)
const activeHref = nav
  .map((n) => n.href)
  .filter((h) => (h === '/' ? current === '/' : current.startsWith(h)))
  .sort((a, b) => b.length - a.length)[0];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#0f4567" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(share.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(share.attributes.height ?? Math.round((1200 * image.height) / image.width))} />
    <meta property="og:image:alt" content={image === defaultShare ? 'moonstruck – soul blues jazz, Band aus Visp' : fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:site_name" content="moonstruck" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="apple-touch-icon" href={appleIcon.src} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/markdown" title="llms.txt" href={url('/llms.txt')} />
    {structured.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class:list={[{ dark }]}>
    <a class="skip" href="#main">Zum Inhalt springen</a>

    <header class="masthead">
      <a href={url('/')} class="masthead__img" aria-label="moonstruck – zur Startseite">
        <Image src={header} alt="moonstruck – soul blues jazz" loading="eager" fetchpriority="high" widths={[889]} sizes="889px" />
      </a>
    </header>

    <nav class="nav" aria-label="Hauptnavigation">
      <div class="nav__inner wrap">
        <button class="nav__toggle" aria-expanded="false" aria-controls="nav-list">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
          Menü
        </button>
        <ul id="nav-list" class="nav__list">
          {
            nav.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  class:list={[{ active: item.href === activeHref, 'nav__btn': item.button }]}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <span>© {new Date().getFullYear()} Moonstruck · soul blues jazz · <a href={url('/impressum/')}>Impressum</a></span>
        <span>sponsored by <a href="https://www.nowhow.ch" rel="noopener">nowhow solutions AG</a></span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
      const list = document.getElementById('nav-list');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        list?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 100;
    background: var(--white);
    color: var(--ink);
    padding: 8px 14px;
    border-radius: 8px;
  }
  .skip:focus {
    left: 8px;
  }

  /* Headerbild: links schwarz (Bühne), rechts Verlauf wie im Bild, unten die blaue Leiste */
  .masthead {
    display: flex;
    justify-content: center;
    background:
      linear-gradient(to bottom, transparent 80.5%, var(--navy-700) 80.5%),
      linear-gradient(to right, #000 50%, transparent 50%),
      linear-gradient(to bottom, #004467 0%, #002537 39%, #000407 73%, #000103 80%);
  }
  .masthead__img {
    display: block;
    width: min(100%, 889px);
  }
  .masthead__img :global(img) {
    width: 100%;
    height: auto;
  }

  .nav__inner {
    display: flex;
    justify-content: center;
  }
  .nav__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem 1.4rem;
    width: 100%;
    margin: 0;
    padding: 1.1rem 0 1rem;
    list-style: none;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .nav__list a {
    position: relative;
    display: block;
    padding: 0.45rem 0.1rem;
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }
  .nav__list a:not(.nav__btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }
  .nav__list a:hover::after,
  .nav__list a.active::after {
    transform: scaleX(1);
  }
  .nav__list a.nav__btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--navy-900);
  }
  .nav__list a.nav__btn:hover {
    background: var(--accent-hover);
  }
  .nav__list a.nav__btn.active {
    box-shadow: 0 0 0 2px var(--white);
  }
  .nav__toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem auto;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: none;
    color: var(--white);
    font: 600 0.95rem var(--font-display);
    cursor: pointer;
  }
  .nav__toggle svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  @media (max-width: 720px) {
    .nav__inner {
      flex-direction: column;
    }
    .nav__toggle {
      display: inline-flex;
    }
    .nav__list {
      display: none;
      flex-direction: column;
      padding-top: 0.25rem;
    }
    .nav__list.open {
      display: flex;
    }
    .nav__list a {
      padding: 0.6rem 0.5rem;
      font-size: 1rem;
    }
  }

  .footer {
    margin-top: clamp(40px, 6vw, 64px);
    background: var(--footer);
    color: #d4d4d4;
    font-size: 0.8rem;
  }
  .footer a {
    color: var(--white);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 20px;
  }
</style>
