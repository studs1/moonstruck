---
import { sounds } from '../data/site';
import { url } from '../lib/util';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? sounds.slice(0, limit) : sounds;
---

<div class="player" data-player>
  <audio preload="none"></audio>
  <ol class="tracks">
    {
      list.map((s, i) => (
        <li>
          <button class="track" type="button" data-src={url(`/audio/${s.file}`)}>
            <span class="track__icon" aria-hidden="true">
              <svg class="i-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
            </span>
            <span class="track__no">{String(i + 1).padStart(2, '0')}</span>
            <span class="track__title">
              {s.title}
              {s.artist && <small>{s.artist}</small>}
            </span>
            <span class="track__time" data-time />
            <span class="track__bar" aria-hidden="true"><span /></span>
          </button>
        </li>
      ))
    }
  </ol>
  <p class="note">Liveaufnahmen aus diversen Konzerten – nur zu Demozwecken.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
    const audio = root.querySelector('audio')!;
    let current: HTMLButtonElement | null = null;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    root.querySelectorAll<HTMLButtonElement>('.track').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (current === btn) {
          audio.paused ? audio.play() : audio.pause();
          return;
        }
        current?.classList.remove('playing', 'active');
        current = btn;
        btn.classList.add('active');
        audio.src = btn.dataset.src!;
        audio.play();
      });
    });

    audio.addEventListener('play', () => current?.classList.add('playing'));
    audio.addEventListener('pause', () => current?.classList.remove('playing'));
    audio.addEventListener('timeupdate', () => {
      if (!current || !audio.duration) return;
      current.querySelector<HTMLElement>('.track__bar span')!.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
      current.querySelector<HTMLElement>('[data-time]')!.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
    });
    audio.addEventListener('ended', () => {
      const next = current?.closest('li')?.nextElementSibling?.querySelector<HTMLButtonElement>('.track');
      next ? next.click() : current?.classList.remove('playing');
    });
  });
</script>

<style>
  .tracks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .track {
    position: relative;
    display: grid;
    grid-template-columns: 44px 2.2em 1fr auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 10px 18px 10px 10px;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: background 0.15s ease;
  }
  .track:hover,
  .track.active {
    background: rgb(255 255 255 / 0.12);
  }
  .track__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    color: var(--navy-900);
  }
  .track__icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .i-pause,
  .playing .i-play {
    display: none;
  }
  .playing .i-pause {
    display: block;
  }
  .track__no {
    font-family: var(--font-display);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .track__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--white);
  }
  .track__title small {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--accent);
  }
  .track__time {
    font-size: 0.85rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .track__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
  }
  .track__bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }
  .note {
    opacity: 0.85;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--accent);
  }
</style>
