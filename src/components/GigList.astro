---
import type { CollectionEntry } from 'astro:content';

interface Props {
  gigs: CollectionEntry<'auftritte'>[];
}
const { gigs } = Astro.props;
const day = new Intl.DateTimeFormat('de-CH', { day: '2-digit', timeZone: 'UTC' });
const mon = new Intl.DateTimeFormat('de-CH', { month: 'short', timeZone: 'UTC' });
const year = new Intl.DateTimeFormat('de-CH', { year: 'numeric', timeZone: 'UTC' });
const weekday = new Intl.DateTimeFormat('de-CH', { weekday: 'long', timeZone: 'UTC' });
---

{
  gigs.length === 0 ? (
    <p class="empty">Zurzeit sind keine öffentlichen Auftritte geplant – buchen Sie uns für Ihren Anlass!</p>
  ) : (
    <ul class="gigs">
      {gigs.map((g) => (
        <li class="gig">
          <time class="gig__date" datetime={g.data.date.toISOString().slice(0, 10)}>
            <span class="gig__day">{day.format(g.data.date)}</span>
            <span class="gig__mon">{mon.format(g.data.date).replace('.', '')}</span>
            <span class="gig__year">{year.format(g.data.date)}</span>
          </time>
          <div class="gig__body">
            <h3>{g.data.title}</h3>
            <p>
              {weekday.format(g.data.date)} · {g.data.ort}
              {g.data.zeit && <> · {g.data.zeit}</>}
            </p>
          </div>
          {g.data.link && (
            <a class="gig__link" href={g.data.link} rel="noopener">
              Infos →
            </a>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .gigs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .gig {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .gig__date {
    display: grid;
    justify-items: center;
    min-width: 72px;
    padding: 8px 6px;
    border-radius: 12px;
    background: var(--white);
    color: var(--navy-800);
    font-family: var(--font-display);
    line-height: 1.05;
  }
  .gig__day {
    font-size: 1.8rem;
    font-weight: 700;
  }
  .gig__mon {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--blue-500);
  }
  .gig__year {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .gig__body h3 {
    margin: 0 0 0.15em;
    font-size: 1.3rem;
  }
  .gig__body p {
    margin: 0;
    opacity: 0.85;
  }
  .gig__link {
    margin-left: auto;
    white-space: nowrap;
  }
  .empty {
    opacity: 0.85;
  }
</style>
