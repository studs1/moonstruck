---
import type { CollectionEntry } from 'astro:content';

interface Props {
  gigs: CollectionEntry<'auftritte'>[];
  /** Beschriftung über dem Titel, z.B. "Nächster Auftritt" */
  label?: string;
}
const { gigs, label } = Astro.props;
const day = new Intl.DateTimeFormat('de-CH', { day: '2-digit', timeZone: 'UTC' });
const mon = new Intl.DateTimeFormat('de-CH', { month: 'short', timeZone: 'UTC' });
const long = new Intl.DateTimeFormat('de-CH', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

{
  gigs.length === 0 ? (
    <div class="gig panel--dark">
      <div class="gig__body">
        {label && <span class="eyebrow">{label}</span>}
        <p class="gig__title">Zurzeit keine öffentlichen Auftritte geplant</p>
        <p class="gig__meta">Buchen Sie uns für Ihren Anlass!</p>
      </div>
      <slot />
    </div>
  ) : (
    <ul class="gigs">
      {gigs.map((g, i) => (
        <li class="gig panel--dark">
          <time class="gig__date" datetime={g.data.date.toISOString().slice(0, 10)}>
            <span class="gig__day">{day.format(g.data.date)}</span>
            <span class="gig__mon">{mon.format(g.data.date).replace('.', '')}</span>
          </time>
          <div class="gig__body">
            {label && <span class="eyebrow">{label}</span>}
            <p class="gig__title">
              {
                g.data.link ? (
                  <a href={g.data.link} rel="noopener" target="_blank" title={`Website: ${g.data.title}`}>
                    {g.data.title}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
                  </a>
                ) : (
                  g.data.title
                )
              }
              , {g.data.ort}
            </p>
            <p class="gig__meta">
              {long.format(g.data.date)}
              {g.data.zeit && <> · {g.data.zeit}</>}
            </p>
          </div>
          {(g.data.tickets || i === 0) && (
            <div class="gig__actions">
              {g.data.tickets && (
                <a class="btn btn--accent" href={g.data.tickets} rel="noopener" target="_blank">
                  Tickets
                </a>
              )}
              {i === 0 && <slot />}
            </div>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .gigs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .gig {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding: 20px 24px;
  }
  .gig__date {
    display: grid;
    place-content: center;
    justify-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--white);
    color: var(--navy-900);
    font-family: var(--font-display);
    line-height: 1;
    flex: none;
  }
  .gig__day {
    font-size: 1.35rem;
    font-weight: 700;
  }
  .gig__mon {
    margin-top: 2px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .gig__body {
    flex: 1;
    min-width: 200px;
  }
  .gig__title {
    margin: 0 0 0.15em;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .gig__title a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgb(134 208 242 / 0.6);
    text-underline-offset: 4px;
  }
  .gig__title a:hover {
    color: var(--accent);
  }
  .gig__title svg {
    width: 0.75em;
    height: 0.75em;
    margin-left: 2px;
    vertical-align: 0.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .gig__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .gig__meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
</style>
