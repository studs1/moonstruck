---
/**
 * "Justified Grid": jede Zeile gleich hoch, alle Bilder im Originalformat (kein Beschnitt).
 * Reines CSS (flex-grow = Seitenverhältnis) → Platz ist vor dem Laden reserviert, nichts springt.
 * Die Links tragen die Daten für die PhotoSwipe-Lightbox (data-pswp-*).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface PhotoItem {
  img: ImageMetadata;
  alt: string;
  caption?: string;
  /** Platzhalter (Data-URI) */
  ph: string;
  /** grosse Version für die Lightbox */
  full: { src: string; srcset: string; width: number; height: number };
  /** fortlaufende Nummer in der ganzen Galerie (für teilbare Links #foto-N) */
  n: number;
}

interface Props {
  items: PhotoItem[];
}
const { items } = Astro.props;
---

<div class="jg">
  {
    items.map((it) => {
      const r = it.img.width / it.img.height;
      return (
        <a
          class="ph"
          href={it.full.src}
          data-pswp-src={it.full.src}
          data-pswp-srcset={it.full.srcset}
          data-pswp-width={it.full.width}
          data-pswp-height={it.full.height}
          data-caption={it.caption}
          data-n={it.n}
          style={`--r:${r.toFixed(4)};background-image:url(${it.ph})`}
        >
          <i aria-hidden="true" />
          <Picture
            src={it.img}
            alt={it.alt}
            formats={['avif', 'webp']}
            widths={[360, 720]}
            sizes="(max-width: 600px) 60vw, 360px"
            loading="lazy"
            decoding="async"
          />
          {it.caption && <span class="cap">{it.caption}</span>}
        </a>
      );
    })
  }
</div>

<style>
  .jg {
    --h: 240px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* letzte Zeile nicht auf volle Breite ziehen */
  .jg::after {
    content: '';
    flex-grow: 999999;
  }
  @media (max-width: 600px) {
    .jg {
      --h: 110px; /* zwei Querformate pro Zeile */
      gap: 4px;
    }
  }
  .ph {
    position: relative;
    display: block;
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--h));
    overflow: hidden;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    background-color: var(--navy-900);
  }
  .ph i {
    display: block;
    padding-bottom: calc(100% / var(--r));
  }
  .ph :global(picture),
  .ph :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ph :global(img) {
    object-fit: cover;
    transition: transform 0.35s ease, filter 0.2s ease;
  }
  .ph:hover :global(img) {
    transform: scale(1.03);
  }
  .ph:focus-visible {
    outline-offset: 2px;
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px 10px 8px;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--white);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.7));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ph:hover .cap,
  .ph:focus-visible .cap {
    opacity: 1;
  }
</style>
