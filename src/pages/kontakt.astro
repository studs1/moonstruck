---
import { breadcrumbSchema } from '../lib/schema';
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';

const tel = contact.phone.replace(/\s/g, '');
const jsonLd = [breadcrumbSchema(Astro.site, [{ name: 'Home', path: '/' }, { name: 'Kontakt', path: '/kontakt/' }])];
---

<Base title="Kontakt" description="moonstruck buchen: Jazz-, Soul- und Bluesband für Hochzeit, Firmenfest, Festival oder Konzert im Wallis und in der ganzen Schweiz. Kontakt in Visp." jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-head">
      <span class="eyebrow">Kontakt</span>
      <h1>moonstruck <span class="hl">an Ihrem Anlass?</span></h1>
      <p class="lead">
        Möchten Sie die moonstruck engagieren, haben Sie Fragen zur Stilrichtung oder sonst irgendein komisches Anliegen? Zögern Sie nicht und nehmen Sie
        unverzüglich mit uns Kontakt auf.
      </p>
    </header>

    <section class="contact sheet">
      <div>
        <span class="eyebrow">Die ultimative Kontaktadresse</span>
        <address>
          <strong>{contact.name}</strong><br />
          {contact.person}<br />
          {contact.street}<br />
          {contact.city}
        </address>
      </div>
      <div class="contact__actions">
        <a class="btn btn--dark" href={`mailto:${contact.email}?subject=Anfrage%20moonstruck`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg
          >
          {contact.email}
        </a>
        <a class="btn btn--line" href={`tel:${tel}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"
            ><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"></path></svg
          >
          {contact.phone}
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(24px, 4vw, 36px);
  }
  address {
    font-style: normal;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  address strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--navy-900);
  }
  .contact__actions {
    display: grid;
    gap: 10px;
  }
  .btn--line {
    border-color: var(--navy-900);
    color: var(--navy-900);
  }
  .btn--line:hover {
    background: #eef5fa;
    color: var(--navy-900);
  }
</style>
