---
import { breadcrumbSchema } from '../../lib/schema';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const members = (await getCollection('mitglieder')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = [breadcrumbSchema(Astro.site, [{ name: 'Home', path: '/' }, { name: 'Die Band', path: '/die-band/' }, { name: 'Bandmitglieder', path: '/die-band/bandmitglieder/' }])];
---

<Base title="Bandmitglieder" description="Die acht Musiker der Jazz- und Soulband moonstruck aus Visp: Klarinette, Saxophon, Trompete, Posaune, Piano, Gitarre, Sousaphon, Schlagzeug und Gesang." jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-head">
      <span class="eyebrow">Die Band</span>
      <h1>Die Musiker <span class="hl">hinter Moonstruck</span></h1>
      <p class="lead">Mit der Maus über ein Foto fahren (oder antippen), um die Musiker live zu sehen.</p>
    </header>

    <ul class="members">
      {
        members.map((m) => (
          <li id={m.id} class="member" tabindex="0">
            <div class="member__img">
              <Image src={m.data.portrait} alt={`Portrait ${m.data.name}`} widths={[300, 500]} sizes="(max-width: 600px) 50vw, 240px" />
              {m.data.live && <Image class="member__live" src={m.data.live} alt={`${m.data.name} live`} widths={[300, 500]} sizes="(max-width: 600px) 50vw, 240px" />}
            </div>
            <div class="member__body">
              <h2>{m.data.name}</h2>
              <p>{m.data.instrument}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    grid-auto-rows: 1fr; /* alle Karten gleich hoch */
  }
  @media (max-width: 520px) {
    .members {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
  .member {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow);
    scroll-margin-top: 24px;
    outline: none;
  }
  .member:target {
    box-shadow: 0 0 0 3px var(--accent), var(--shadow);
  }
  .member__img {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #e9eef2;
  }
  .member__img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .member__img :global(.member__live) {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .member:hover :global(.member__live),
  .member:focus :global(.member__live) {
    opacity: 1;
  }
  .member__body {
    padding: 14px 16px 16px;
  }
  .member__body h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--navy-900);
    margin: 0 0 0.2em;
  }
  .member__body p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--blue-500);
  }
</style>
